"""
Environment variables for Code Quality Agent
"""

# API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Application settings
APP_NAME=Autonomous Code Quality & Performance Agent
APP_VERSION=1.0.0
DEBUG=True
PORT=8000

# Analysis settings
MAX_FILE_SIZE=1048576  # 1MB
SUPPORTED_LANGUAGES=["python", "javascript", "c"]
MAX_ITERATIONS=10  # Agent loop max iterations